# ── دستیار هوشمند (Claude) ──
# کلید را از https://console.anthropic.com بگیرید
ANTHROPIC_API_KEY=
# مدل (پیش‌فرض claude-opus-5)
# CIVILDESK_MODEL=claude-opus-5
# عمق فکر کردن: low | medium | high  (خالی = پیش‌فرض مدل)
# CIVILDESK_EFFORT=
# 0 = غیرفعال کردن مدل جایگزین در صورت رد درخواست
# CIVILDESK_FALLBACKS=1

# ── برنامه ──
CIVILDESK_OWNER=مهندس
CIVILDESK_CURRENCY=ریال
CIVILDESK_TZ=Asia/Tehran
CIVILDESK_DB=data/civildesk.db
# اگر برنامه روی اینترنت در دسترس است حتماً رمز بگذارید (نام کاربری هر چیزی می‌تواند باشد)
CIVILDESK_PASSWORD=

# ── ربات تلگرام ──
# توکن را از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# شناسه‌ی چت‌های مجاز، با ویرگول جدا (با فرستادن /id به ربات به دست می‌آید)
TELEGRAM_ALLOWED_CHAT_IDS=
# ساعت ارسال گزارش صبحگاهی
DAILY_BRIEF_TIME=07:30
